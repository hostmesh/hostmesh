# Reverse proxy for local development, on the hostname layout of spec
# section 28. Certificates come from Caddy's internal CA. The API hostname
# proxies to the control plane, and the two app hostnames to Vite's dev
# servers in the node service. The agent hostname serves a placeholder
# until the agent endpoint exists.
{
	local_certs
	skip_install_trust
}

app.hostmesh.test {
	reverse_proxy node:5174
}

admin.hostmesh.test {
	reverse_proxy node:5173
}

api.hostmesh.test {
	# Every request goes to Laravel's front controller. Caddy does not see
	# the application's files, so `root` is the path inside the php service.
	rewrite * /index.php
	reverse_proxy php:9000 {
		transport fastcgi {
			root /var/www/html/public
			split .php
		}
	}
}

agent.hostmesh.test {
	respond "Hostmesh development placeholder: agent endpoint"
}
