//
// The browser code. No Node types here: `process` or `node:fs` in a
// component must not typecheck. vite.config.ts is in tsconfig.node.json.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
