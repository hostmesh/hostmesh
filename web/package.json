{
  "name": "hostmesh-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "vitest run",
    "build": "pnpm --filter \"./apps/*\" run build",
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "generate:api": "pnpm --filter @hostmesh/api-client run generate",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-eslint-parser": "catalog:"
  }
}
