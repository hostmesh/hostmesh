{
    "openapi": "3.1.0",
    "info": {
        "title": "Hostmesh API",
        "version": "v1",
        "description": "The Hostmesh control plane API."
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "paths": {
        "/admin/auth/csrf-cookie": {
            "get": {
                "operationId": "admin.auth.csrf-cookie",
                "description": "Sets the admin session cookie and the `XSRF-TOKEN-ADMIN` cookie.\nThe admin app sends the value of that cookie in the `X-XSRF-TOKEN`\nheader of every state-changing request. Call it once before logging in.\nOnly the admin origin may call it.",
                "summary": "Start the CSRF cookie flow (admin)",
                "tags": [
                    "CsrfCookie"
                ],
                "responses": {
                    "204": {
                        "description": "The cookies are set.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/customer/auth/csrf-cookie": {
            "get": {
                "operationId": "customer.auth.csrf-cookie",
                "description": "Sets the portal session cookie and the `XSRF-TOKEN-PORTAL` cookie.\nThe portal sends the value of that cookie in the `X-XSRF-TOKEN`\nheader of every state-changing request. Call it once before logging in.\nOnly the portal origin may call it.",
                "summary": "Start the CSRF cookie flow (portal)",
                "tags": [
                    "CsrfCookie"
                ],
                "responses": {
                    "204": {
                        "description": "The cookies are set.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/health": {
            "get": {
                "operationId": "v1.health",
                "description": "Reports that the application booted and can answer. It checks no dependency.",
                "summary": "Liveness check",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "The API is up.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "$ref": "#/components/schemas/HealthStatus"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "HealthStatus": {
                "type": "string",
                "enum": [
                    "ok"
                ],
                "title": "HealthStatus"
            }
        }
    }
}