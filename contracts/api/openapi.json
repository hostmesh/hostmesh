{
    "openapi": "3.1.0",
    "info": {
        "title": "Hostmesh API",
        "version": "v1",
        "description": "The Hostmesh control plane API."
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "paths": {
        "/admin/auth/csrf-cookie": {
            "get": {
                "operationId": "admin.auth.csrf-cookie",
                "description": "Sets the admin session cookie and the `XSRF-TOKEN-ADMIN` cookie.\nThe admin app sends the value of that cookie in the `X-XSRF-TOKEN`\nheader of every state-changing request. Call it once before logging in.\nOnly the admin origin may call it.",
                "summary": "Start the CSRF cookie flow (admin)",
                "tags": [
                    "CsrfCookie"
                ],
                "responses": {
                    "204": {
                        "description": "The cookies are set.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/admin/auth/login": {
            "post": {
                "operationId": "admin.auth.login",
                "description": "Starts an administrator session. Call `GET /admin/auth/csrf-cookie` first\nand send `X-XSRF-TOKEN`. A wrong password and an unknown email produce the same response.\nLimited to 5 attempts per minute for one email from one address.",
                "summary": "Log in (admin)",
                "tags": [
                    "Login"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`AdministratorResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AdministratorResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "An error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview.",
                                            "examples": [
                                                ""
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/admin/auth/logout": {
            "post": {
                "operationId": "admin.auth.logout",
                "description": "Ends the administrator session. The session ID stops working on the server.",
                "summary": "Log out (admin)",
                "tags": [
                    "Logout"
                ],
                "responses": {
                    "204": {
                        "description": "The session has ended.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/admin/auth/user": {
            "get": {
                "operationId": "admin.auth.user",
                "description": "The administrator of the current session.",
                "summary": "Current user (admin)",
                "tags": [
                    "CurrentUser"
                ],
                "responses": {
                    "200": {
                        "description": "`AdministratorResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AdministratorResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/customer/auth/csrf-cookie": {
            "get": {
                "operationId": "customer.auth.csrf-cookie",
                "description": "Sets the portal session cookie and the `XSRF-TOKEN-PORTAL` cookie.\nThe portal sends the value of that cookie in the `X-XSRF-TOKEN`\nheader of every state-changing request. Call it once before logging in.\nOnly the portal origin may call it.",
                "summary": "Start the CSRF cookie flow (portal)",
                "tags": [
                    "CsrfCookie"
                ],
                "responses": {
                    "204": {
                        "description": "The cookies are set.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/customer/auth/login": {
            "post": {
                "operationId": "customer.auth.login",
                "description": "Starts a customer session. Call `GET /customer/auth/csrf-cookie` first and send `X-XSRF-TOKEN`. A wrong password and an unknown email produce the same response. Limited to 5 attempts per minute for one email from one address.",
                "summary": "Log in (portal)",
                "tags": [
                    "Login"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "An error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview.",
                                            "examples": [
                                                ""
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/customer/auth/logout": {
            "post": {
                "operationId": "customer.auth.logout",
                "description": "Ends the customer session. The session ID stops working on the server.",
                "summary": "Log out (portal)",
                "tags": [
                    "Logout"
                ],
                "responses": {
                    "204": {
                        "description": "The session has ended.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/customer/auth/user": {
            "get": {
                "operationId": "customer.auth.user",
                "description": "The user of the current session.",
                "summary": "Current user (portal)",
                "tags": [
                    "CurrentUser"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/health": {
            "get": {
                "operationId": "v1.health",
                "description": "Reports that the application booted and can answer. It checks no dependency.",
                "summary": "Liveness check",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "The API is up.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "$ref": "#/components/schemas/HealthStatus"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "AdministratorResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email"
                ],
                "title": "AdministratorResource"
            },
            "HealthStatus": {
                "type": "string",
                "enum": [
                    "ok"
                ],
                "title": "HealthStatus"
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "UserResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email"
                ],
                "title": "UserResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}