{
    "openapi": "3.1.0",
    "info": {
        "title": "Hostmesh API",
        "version": "v1",
        "description": "The Hostmesh control plane API."
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "paths": {
        "/health": {
            "get": {
                "operationId": "v1.health",
                "description": "Reports that the application booted and can answer. It checks no dependency.",
                "summary": "Liveness check",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "The API is up.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "$ref": "#/components/schemas/HealthStatus"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "HealthStatus": {
                "type": "string",
                "enum": [
                    "ok"
                ],
                "title": "HealthStatus"
            }
        }
    }
}