{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hostmesh/control-plane",
    "type": "project",
    "description": "The Hostmesh control plane: desired state, billing and the versioned REST API.",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "dedoc/scramble": "^0.13.47",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "pragmarx/google2fa": "^9.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3.2",
        "pestphp/pest-plugin-laravel": "^5.0",
        "spaze/phpstan-disallowed-calls": "^4.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test -v",
        "lint:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": [
            "@php artisan config:clear --ansi",
            "pest --parallel"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi",
            "pest --parallel --coverage --min=95"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test:coverage"
        ],
        "openapi": "@php artisan scramble:export",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
