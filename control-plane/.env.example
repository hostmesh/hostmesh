# SPDX-License-Identifier: Apache-2.0
#
# Local development againsts the stack in infrastructure/development. The
# database credentials are the development-only values of
# infrastructure/development/.env.example. Copy to .env; git ignores .env.

APP_NAME=LHostmesh
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.hostmesh.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is authoritative for platform state.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hostmesh
DB_USERNAME=hostmesh
DB_PASSWORD=hostmesh

# Redis carries queues and cache. It is never the source of truth.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
