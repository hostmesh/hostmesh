# Reverse proxy for local development, on the hostname layout of spec
# section 28. Certificates come from Caddy's internal CA. The API hostname
# proxies to the control plane. The other hostnames serve a placeholder
# until their application exists; each site block then changes from
# `respond` to `reverse_proxy`.
{
	local_certs
	skip_install_trust
}

app.hostmesh.test {
	respond "Hostmesh development placeholder: customer portal"
}

admin.hostmesh.test {
	respond "Hostmesh development placeholder: admin app"
}

api.hostmesh.test {
	# Every request goes to Laravel's front controller. Caddy does not see
	# the application's files, so `root` is the path inside the php service.
	rewrite * /index.php
	reverse_proxy php:9000 {
		transport fastcgi {
			root /var/www/html/public
			split .php
		}
	}
}

agent.hostmesh.test {
	respond "Hostmesh development placeholder: agent endpoint"
}
