#
# Local development only. `make up` copies this file to `.env`, which git
# ignores. PostgreSQL is not published to the host, so these values are
# reachable only from containers in the Compose project.
#
# PostgreSQL applies them when its volume is first created. To change them
# later, edit `.env` and run `make reset` (this deletes the database).
POSTGRES_DB=hostmesh
POSTGRES_USER=hostmesh
POSTGRES_PASSWORD=hostmesh
