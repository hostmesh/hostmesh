root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{js,ts,vue,json,yml,yaml,css,md}]
indent_size = 2

[Makefile]
indent_style = tab

[Caddyfile]
indent_style = tab

# Generated by `composer openapi` and compared byte for byte: 4-space indent,
# no final newline. Never edit it by hand.
[contracts/api/openapi.json]
indent_size = 4
insert_final_newline = false

# Generated by `pnpm generate:api` and compared byte for byte: 4-space
# indent. Never edit it by hand.
[web/packages/api-client/src/generated/**]
indent_size = 4
